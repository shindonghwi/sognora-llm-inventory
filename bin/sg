#!/usr/bin/env bash
# sg — 이 무기고의 단일 진입점. 사람은 스킬 이름만 부른다(/sg-web-replicate …). 이 CLI는 스킬이 자기 계기를 찾을 때와 레포를 고칠 때만 쓴다.
set -euo pipefail

# ── 스킬 위치 해석 — 레포·심링크·플러그인 캐시 어디서 돌려도 같게. 기준 스킬은 sg-web-replicate ──
ANCHOR="sg-web-replicate"
resolve_skills() {
  [ -n "${SG_HOME:-}" ] && [ -d "$SG_HOME" ] && { echo "$SG_HOME"; return; }
  local here repo
  here="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
  repo="$(cd "$here/.." && pwd)"
  [ -d "$repo/plugins/sognora-llm-inventory/skills/$ANCHOR" ] && { echo "$repo/plugins/sognora-llm-inventory/skills"; return; }
  [ -d "${CLAUDE_HOME:-$HOME/.claude}/skills/$ANCHOR" ] && { echo "${CLAUDE_HOME:-$HOME/.claude}/skills"; return; }
  # 플러그인 캐시: 버전 디렉터리가 여럿이면 가장 최근 수정본 하나로 — find|head의 비결정성을 피한다
  local cache
  cache="$(ls -td "${CLAUDE_HOME:-$HOME/.claude}"/plugins/cache/*/*/*/skills/$ANCHOR 2>/dev/null | head -1)"
  [ -n "$cache" ] && { dirname "$cache"; return; }
  cache="$(ls -td "${CODEX_HOME:-$HOME/.codex}"/plugins/cache/*/*/*/skills/$ANCHOR 2>/dev/null | head -1)"
  [ -n "$cache" ] && { dirname "$cache"; return; }
  echo ""
}
SKILLS="$(resolve_skills)"
REPO_ROOT="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
[ -z "$SKILLS" ] && { echo "🔴 스킬을 못 찾았다. SG_HOME=<skills 디렉터리> 로 지정하거나 setup.sh 로 설치하라." >&2; exit 2; }

usage() {
cat <<'H'
sg — sognora 스킬 무기고 (스킬·레포 정비용. 사용자는 /sg-<스킬> 만 부른다)

  sg path <스킬>     그 스킬의 scripts 경로 — SKILL.md의 $S가 이걸 쓴다
  sg check           레포 자체 점검 — push 전
  sg help
H
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  check)  exec "$REPO_ROOT/tools/check.sh" ;;
  path)
    [ -z "${1:-}" ] && { echo "usage: sg path <스킬>" >&2; exit 2; }
    [ -d "$SKILLS/$1/scripts" ] || { echo "🔴 $1 에 scripts/ 가 없다 ($SKILLS/$1)" >&2; exit 2; }
    exec echo "$SKILLS/$1/scripts" ;;
  help|-h|--help) usage ;;
  *) echo "알 수 없는 명령: $cmd" >&2; echo >&2; usage >&2; exit 2 ;;
esac
